diff --git a/.github/workflows/model-cache.yml b/.github/workflows/model-cache.yml
new file mode 100644
index 0000000..ca40aa4
--- /dev/null
+++ b/.github/workflows/model-cache.yml
@@ -0,0 +1,38 @@
+name: Model Cache
+
+on:
+  workflow_call:
+    outputs:
+      cache-key:
+        value: ${{ jobs.models.outputs.cache-key }}
+
+jobs:
+  models:
+    name: "Download Models"
+    runs-on: ubuntu-latest
+    outputs:
+      cache-key: ${{ steps.model-cache.outputs.cache-primary-key }}
+    steps:
+      - uses: actions/checkout@93cb6efe18208431cddfb8368fd83d5badbf9bfd #v5.0.1
+      - name: Get Model Revision
+        id: model-revision
+        run: |
+          sha=$(git ls-remote https://huggingface.co/argmaxinc/whisperkit-coreml HEAD | cut -f1)
+          test -n "$sha"
+          echo "sha=$sha" >> "$GITHUB_OUTPUT"
+      - name: Setup Cache
+        id: model-cache
+        uses: actions/cache/restore@27d5ce7f107fe9357f9df03efb73ab90386fccae #v5.0.5
+        with:
+          path: Models
+          key: macOS-models-${{ steps.model-revision.outputs.sha }}
+          restore-keys: macOS-models
+      - name: Download Models
+        if: steps.model-cache.outputs.cache-hit != 'true'
+        run: make download-model MODEL=tiny
+      - name: Save Cache
+        if: steps.model-cache.outputs.cache-hit != 'true'
+        uses: actions/cache/save@27d5ce7f107fe9357f9df03efb73ab90386fccae #v5.0.5
+        with:
+          path: Models
+          key: ${{ steps.model-cache.outputs.cache-primary-key }}
